<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
	<vertical vertical-fit='PreferredSize' preferred-height='75' pad-right='20' pad-top='1' pad-bottom='3'>
		<horizontal preferred-width='90'>
			<text text='Reaction Time Presets Window' font-size='5' underlined='true' align='Center'></text>
		</horizontal>
		<checkbox-setting value='quick_enabled_value' on-change='set_quick_enabled' apply-on-change='true' text='Show quick RT window' hover-hint='Small window in front of you (bottom center) with reaction time presets'></checkbox-setting>
		<checkbox-setting value='quick_unlocked_value' on-change='set_quick_unlocked' apply-on-change='true' text='Unlock window (show handle)' hover-hint='Show a handle under the window so you can grab and move it. Position is saved when you release it'></checkbox-setting>
		<slider-setting value='quick_scale_value' show-buttons='true' on-change='set_quick_scale' apply-on-change='true' bind-value='true' text='Window size' increment='0.05' min='0.4' max='1.5' formatter='quick_scale_formatter' hover-hint='Size of the quick RT window'></slider-setting>
		<button align='Center' on-click='reset_position_clicked' text='Reset window position' hover-hint='Put the window back at the bottom center'></button>
		<horizontal>
			<text text='------' font-color='#00000000' font-size='1' align='Left'></text>
		</horizontal>
		<horizontal>
			<text text='Slider limit' font-size='5' underlined='true' font-color='#ffff00ff' align='Center'></text>
		</horizontal>
		<slider-setting value='max_rt_value' show-buttons='true' on-change='set_max_rt' apply-on-change='true' bind-value='true' text='Max Reaction Time' increment='50' min='400' max='3000' formatter='max_rt_formatter' hover-hint='Upper limit of the Reaction Time sliders and presets. Default 1600 ms'></slider-setting>
		<horizontal preferred-width='90'>
			<text text='Presets and the +/- buttons in the window never go above this value.' font-size='3' font-color='#cc99ffff' align='Left'></text>
		</horizontal>
		<horizontal preferred-width='90'>
			<text text='Applying a preset switches JDFixer to the Reaction Time slider.' font-size='3' font-color='#cc99ffff' align='Left'></text>
		</horizontal>
	</vertical>
</bg>